{
  "name": "@lol/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include ../.env --env-file-if-exists=../.env src/server.ts",
    "start": "tsx src/server.ts",
    "build": "esbuild src/handler.ts --bundle --platform=node --format=esm --external:express --outfile=dist/handler.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@lol/shared": "*",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "esbuild": "^0.28.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
